{
  "manifest_version": 3,
  "name": "JobPilot AI — Assisted Apply",
  "version": "0.2.0",
  "description": "User-controlled application copilot. Fills employer forms with your verified JobPilot data — you always review and submit yourself.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open JobPilot Assisted Apply" },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://app.jobpilot.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "exclude_matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://app.jobpilot.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
