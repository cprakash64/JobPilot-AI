{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["chrome", "vitest/globals"],
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": ["src", "build.mjs"],
  // This test asserts against the BUILD ARTIFACT (dist/manifest.json,
  // dist/content.js) and therefore needs Node built-ins. Adding "node" to
  // `types` globally would let browser code reach for `process`/`fs` without a
  // type error, so the one Node-using test is excluded from the browser
  // typecheck instead. Vitest still runs it.
  "exclude": ["src/__tests__/generated_manifest.test.ts"]
}
