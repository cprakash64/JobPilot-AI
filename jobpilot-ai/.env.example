# Template only. Copy to .env and fill in locally — .env is gitignored.
# Every value here is a PLACEHOLDER or a development default. None is a real
# secret, and none may be used in production: with APP_ENV=production, the
# startup check in app/core/config_validation.py refuses to boot on the
# defaults below (see docs/DEPLOYMENT.md).

# development | staging | production. Anything production-like enables the
# strict configuration checks and disables /docs.
APP_ENV=development
DEBUG=false
# Leave unset to follow APP_ENV (docs served outside production only).
# DOCS_ENABLED=

POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev_password
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot_dev_password@postgres:5432/jobpilot
REDIS_URL=redis://redis:6379/0

# Signs JWTs. In production supply >=32 random characters from a secrets
# manager or deployment secret, e.g.  openssl rand -base64 48
# Never commit the real value.
SECRET_KEY=change-me-in-production
JWT_EXPIRES_MINUTES=10080

# Explicit trusted origins. "*" is rejected in production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

OPENAI_API_KEY=
OPENAI_MODEL_SMART=gpt-5.6-sol
OPENAI_MODEL_FAST=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required once DEMOGRAPHICS_ENCRYPTION_REQUIRED=true.
DEMOGRAPHICS_ENCRYPTION_KEY=
DEMOGRAPHICS_ENCRYPTION_REQUIRED=false

# Encrypts the optional Workday application password at rest. Required as a
# separate deployment secret in production; never commit the real value.
WORKDAY_CREDENTIALS_ENCRYPTION_KEY=

UPLOAD_DIR=/app/uploads

# Development convenience ONLY. In production leave this false and run
# `alembic upgrade head` as one explicit release step before rolling replicas;
# the start script refuses this combination when APP_ENV=production.
RUN_MIGRATIONS_ON_STARTUP=true
# Job discovery sources. Real public ATS boards are read from a JSON file
# (default app/jobs/sources_config.json). Point JOB_SOURCES_FILE at your own file
# to override, using {"greenhouse":[{"company":"X","board_token":"x"}], ...}.
JOB_SOURCES_FILE=
# Extra boards via env as "provider:slug:Display Name" (provider=greenhouse|lever|ashby),
# comma-separated. Merged with the JSON file. If neither is set, discovery shows
# setup guidance instead of any jobs — it never fabricates demo jobs.
JOB_SOURCE_COMPANIES=
# Discovery scale/performance.
JOB_DISCOVERY_MAX_COMPANIES=200
JOB_DISCOVERY_MAX_JOBS_PER_SOURCE=100
JOB_DISCOVERY_CONCURRENCY=10
JOB_DISCOVERY_TIMEOUT_SECONDS=12
# Comma-separated source packs to search (empty = auto-select from the profile).
# Options: software_ai_us,new_grad_us,remote_us,startups_us,ai_ml_us,devtools_us,fintech_us,healthcare_tech_us
JOB_DISCOVERY_SOURCE_PACKS=
JOB_DISCOVERY_INCLUDE_UNKNOWN_DATES=false
JOB_DISCOVERY_CACHE_TTL_MINUTES=15

# --- Recurring automated ingestion (scheduler service) ---
# The `scheduler` (Celery beat) container triggers discovery every 24 hours without
# any browser open. The run is guarded by a distributed lock so multiple replicas
# never ingest concurrently.
JOB_INGESTION_ENABLED=true
JOB_INGESTION_SCHEDULE=0 6 * * *
JOB_INGESTION_TIMEZONE=UTC
JOB_POSTED_WITHIN_DAYS=7
JOB_INGESTION_SOURCE_TIMEOUT_SECONDS=60
JOB_INGESTION_MAX_RETRIES=3
JOB_INGESTION_LOCK_TTL_SECONDS=3600
# A job unseen on its official source for this many days is marked inactive.
JOB_EXPIRY_GRACE_DAYS=3

# --- Background scoring (worker service) ---
JOB_SCORING_BATCH_SIZE=100
JOB_SCORING_MAX_ATTEMPTS=3

# --- People Who Can Help (disabled by default; provider keys stay backend-only) ---
# Internal recommendations without email:
#   PEOPLE_RECOMMENDATIONS_ENABLED=true, PEOPLE_ROLLOUT_MODE=internal,
#   PEOPLE_INTERNAL_EMAILS=<comma-separated emails>, PEOPLE_PRIMARY_PROVIDER=pdl,
#   PDL_API_KEY=<backend secret>, and non-zero PDL budget limits.
# Internal recommendations with email additionally require:
#   PEOPLE_EMAIL_DISCOVERY_ENABLED=true, HUNTER_API_KEY=<backend secret>, and
#   PEOPLE_DATA_ENCRYPTION_KEY=<dedicated backend secret>.
# Selected beta users use PEOPLE_ROLLOUT_MODE=beta and
#   PEOPLE_BETA_USER_IDS=<comma-separated persisted user IDs>.
# Public rollout uses PEOPLE_ROLLOUT_MODE=all. Keep provider keys, encryption
# keys, and explicit non-zero budgets configured before enabling it.
PEOPLE_RECOMMENDATIONS_ENABLED=false
# disabled | internal | beta | percentage | all
PEOPLE_ROLLOUT_MODE=disabled
PEOPLE_ROLLOUT_PERCENTAGE=0
PEOPLE_INTERNAL_EMAILS=
PEOPLE_BETA_USER_IDS=
PEOPLE_PRIMARY_PROVIDER=pdl
PEOPLE_APOLLO_DISCOVERY_ENABLED=false
PEOPLE_APOLLO_DIAGNOSTIC_ENABLED=false
PEOPLE_PDL_DISCOVERY_ENABLED=true
PEOPLE_EMAIL_DISCOVERY_ENABLED=false
PEOPLE_PDL_FALLBACK_ENABLED=false
PEOPLE_OUTREACH_DRAFTING_ENABLED=false
PEOPLE_NETWORK_MATCHING_ENABLED=false
PEOPLE_EMPLOYMENT_SECONDARY_VERIFICATION_ENABLED=false
PEOPLE_EMPLOYMENT_COMPARISON_MODE=false
PEOPLE_EMPLOYMENT_VERIFICATION_DAILY_CREDIT_BUDGET=0
PEOPLE_EMPLOYMENT_VERIFICATION_PER_USER_DAILY_LIMIT=0
PEOPLE_EMPLOYMENT_VERIFICATION_TTL_DAYS=30
PEOPLE_EMPLOYMENT_VERIFICATION_MAX_RECRUITERS=1
PEOPLE_EMPLOYMENT_VERIFICATION_MAX_MANAGERS=1
PEOPLE_EMPLOYMENT_VERIFICATION_MAX_REFERRERS=1
PEOPLE_MIN_RECRUITER_RELEVANCE=60
PEOPLE_MIN_MANAGER_RELEVANCE=60
PEOPLE_MIN_REFERRER_RELEVANCE=60
PEOPLE_MIN_DATA_CONFIDENCE=0.5
PEOPLE_RECRUITER_ENRICHMENT_RESERVE=3
PEOPLE_MANAGER_ENRICHMENT_RESERVE=3
PEOPLE_REFERRER_ENRICHMENT_RESERVE=2
APOLLO_API_KEY=
HUNTER_API_KEY=
PDL_API_KEY=
# Dedicated at-rest protection key. Required in production when email discovery is enabled.
PEOPLE_DATA_ENCRYPTION_KEY=
PEOPLE_RESULT_TTL_DAYS=30
PEOPLE_PDL_RESULT_TTL_DAYS=30
PEOPLE_PDL_RESULTS_PER_QUERY=20
PEOPLE_PDL_DAILY_CREDIT_BUDGET=0
PEOPLE_PDL_PER_USER_DAILY_LIMIT=0
PEOPLE_EMPLOYMENT_FRESHNESS_DAYS=180
PEOPLE_EMAIL_RESULT_TTL_DAYS=30
PEOPLE_MAX_DISCOVERY_RESULTS_PER_CATEGORY=20
PEOPLE_MAX_DISPLAYED_RECRUITERS=3
PEOPLE_MAX_DISPLAYED_MANAGERS=3
PEOPLE_MAX_DISPLAYED_REFERRERS=5
PEOPLE_MAX_ENRICHMENTS_PER_JOB=8
# 0 means no configured credit budget; production rollout should set explicit non-zero limits.
PEOPLE_DAILY_CREDIT_BUDGET=0
PEOPLE_PER_USER_DAILY_LIMIT=0
PEOPLE_EMAIL_DAILY_CREDIT_BUDGET=0
PEOPLE_EMAIL_PER_USER_DAILY_LIMIT=0
PEOPLE_PROVIDER_TIMEOUT_SECONDS=8
PEOPLE_PROVIDER_RESPONSE_MAX_BYTES=1000000
PEOPLE_MIN_RELEVANCE_SCORE=60
PEOPLE_DISCOVERY_RATE_LIMIT_PER_HOUR=10
PEOPLE_EMAIL_RATE_LIMIT_PER_HOUR=10
